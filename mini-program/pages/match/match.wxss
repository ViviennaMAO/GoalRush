.tabs {
  display: flex;
  white-space: nowrap;
  margin-bottom: 20rpx;
  padding: 4rpx 0;
}
.tab {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 26rpx;
  margin-right: 12rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  background: #FFFFFF;
  color: #6B7280;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,.03);
}
.tab.active {
  background: #14B8A6;
  color: #FFFFFF;
  box-shadow: 0 4rpx 14rpx rgba(20, 184, 166, .25);
}

.match-card { padding: 26rpx 26rpx 20rpx; margin-bottom: 20rpx; }
.match-card.is-highlight {
  background: linear-gradient(180deg, #FFFFFF, #F0FDF4);
}
.match-top { margin-bottom: 18rpx; }
.match-countdown {
  font-size: 22rpx; color: #14B8A6; font-weight: 700;
  background: #ECFDF5; padding: 4rpx 12rpx; border-radius: 12rpx;
  flex-shrink: 0;
}
.match-teams {
  display: grid; grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 12rpx 0 18rpx;
  gap: 12rpx;
}
.team-name { margin-top: 10rpx; font-size: 26rpx; font-weight: 700; color: #111827; }
.match-vs {
  font-size: 28rpx; font-weight: 700; color: #9CA3AF; letter-spacing: 2rpx;
}
.match-foot { font-size: 22rpx; color: #9CA3AF; }
