<view class="page">

  <!-- ===== Team hero ===== -->
  <view class="card team-hero">
    <view class="col-center" style="gap: 16rpx;">
      <view class="avatar avatar-xl avatar-ring" style="width: 180rpx; height: 180rpx; font-size: 96rpx;">
        <text>{{team.flag}}</text>
      </view>
      <text class="tx-h1" style="margin-top: 8rpx;">{{team.name}}</text>
      <text class="tx-small">{{team.name_en}} · {{team.fans}} 位球迷</text>

      <button wx:if="{{isMyTeam}}" class="btn btn-pill pill-purple" style="margin-top: 16rpx;">✓ 我的阵营</button>
      <button wx:else class="btn btn-primary" style="margin-top: 16rpx;" bindtap="onJoin">加入 {{team.name}} 阵营</button>
    </view>
  </view>

  <!-- ===== 阵营 KOL ===== -->
  <view class="section" wx:if="{{teamKols.length}}">
    <view class="section-head">
      <view>
        <text class="section-title">阵营 KOL</text>
        <view class="section-sub">该队球迷大 V · 跟随他们一起预测</view>
      </view>
    </view>

    <view wx:for="{{teamKols}}" wx:key="id" class="card kol-row">
      <view class="avatar"><text>{{item.flag}}</text></view>
      <view class="col" style="flex: 1; gap: 4rpx;">
        <view class="row row-gap-sm">
          <text class="tx-bold">{{item.name}}</text>
          <text class="pill pill-purple">{{item.tier}}</text>
        </view>
        <text class="tx-small">{{item.handle}} · {{item.followers}} 粉丝 · 命中 {{item.hit_rate}}%</text>
      </view>
    </view>
  </view>

  <!-- ===== 该队近期比赛 ===== -->
  <view class="section">
    <view class="section-head">
      <view>
        <text class="section-title">{{team.code}} 的比赛</text>
        <view class="section-sub">看球 + 押预测 + 和阵营兄弟聊</view>
      </view>
    </view>

    <view wx:if="{{!teamMatches.length}}" class="card" style="text-align: center; color: #9CA3AF;">
      暂无该队比赛
    </view>

    <view wx:for="{{teamMatches}}" wx:key="id" class="card team-match" bindtap="goMatch" data-id="{{item.id}}">
      <view class="row-between">
        <text class="pill pill-light">{{item.competition}}</text>
        <text class="tx-small tx-purple">⏱ {{item.countdown}}</text>
      </view>
      <view class="row-between team-match-row">
        <view class="row row-gap-sm">
          <view class="avatar avatar-sm"><text>{{item.homeTeam.flag}}</text></view>
          <text class="tx-bold">{{item.homeTeam.code}}</text>
        </view>
        <text class="tx-muted">vs</text>
        <view class="row row-gap-sm">
          <text class="tx-bold">{{item.awayTeam.code}}</text>
          <view class="avatar avatar-sm"><text>{{item.awayTeam.flag}}</text></view>
        </view>
      </view>
      <view class="tx-small">💬 {{item.discussions}} 球迷在聊</view>
    </view>
  </view>

  <view class="legal">
    <text>球迷阵营是社交身份 · 加入即可看阵营专属内容</text>
    <text>GoalRush · Powered by Luffa</text>
  </view>

</view>
