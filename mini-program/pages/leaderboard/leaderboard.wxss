.tabs {
  display: flex;
  white-space: nowrap;
  margin-bottom: 24rpx;
  padding: 4rpx 0;
}
.tab {
  display: inline-flex; align-items: center;
  height: 64rpx; padding: 0 28rpx;
  margin-right: 12rpx;
  border-radius: 32rpx;
  font-size: 26rpx; font-weight: 600;
  background: #FFFFFF; color: #6B7280;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.04);
}
.tab.active {
  background: linear-gradient(135deg, #6D5BFF, #8B7AFF);
  color: #FFFFFF;
  box-shadow: 0 6rpx 18rpx rgba(109,91,255,.25);
}

/* ===== 颁奖台 ===== */
.podium-card {
  padding: 40rpx 32rpx;
  display: flex; align-items: flex-end; justify-content: space-around;
  background: linear-gradient(180deg, #FFFFFF, #F5F2FF);
  gap: 16rpx;
}
.podium-step { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.podium-first { transform: translateY(-16rpx); }
.podium-rank { font-size: 36rpx; }
.podium-rank-1 { font-size: 44rpx; }
.podium-handle { font-size: 22rpx; font-weight: 700; color: #1A1A2E; max-width: 180rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.podium-stat { font-size: 22rpx; color: #6D5BFF; font-weight: 700; font-family: ui-monospace, Menlo, monospace; }

/* ===== List ===== */
.list-card { margin-top: 8rpx; }
.list-row {
  display: flex; align-items: center; gap: 16rpx;
  padding: 22rpx 28rpx;
  border-bottom: 2rpx solid #F4F5F7;
}
.list-row:last-child { border-bottom: 0; }
.list-rank {
  font-size: 26rpx; font-weight: 800; color: #6B7280;
  font-family: ui-monospace, Menlo, monospace;
  min-width: 60rpx;
}
.list-handle { font-size: 26rpx; }
.list-val {
  font-size: 28rpx; font-weight: 800; color: #6D5BFF;
  font-family: ui-monospace, Menlo, monospace;
}
