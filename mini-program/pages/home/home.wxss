/* ============================================
   FAN BANNER · 球迷应援(看台 vibe · 俏皮 magazine 风)
   参考 App Store FIFA WC 26 头图:halftone + 飘带 + 大球
   ============================================ */
.fan-banner {
  position: relative;
  border-radius: 28rpx;
  padding: 40rpx 32rpx 36rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, .12);
}

/* 多层装饰叠加 · halftone 点阵 + 流动彩带 + 巨大足球 */
.fan-banner-stripe {
  position: absolute; inset: 0;
  pointer-events: none;
  background:
    /* halftone 点阵(磁带 / pop art 感)*/
    radial-gradient(circle, rgba(255,255,255,.22) 2rpx, transparent 3rpx) 0 0 / 18rpx 18rpx,
    /* 斜向彩带 1 */
    linear-gradient(118deg, transparent 0%, transparent 38%, rgba(255,255,255,.12) 38%, rgba(255,255,255,.12) 46%, transparent 46%),
    /* 斜向彩带 2 */
    linear-gradient(98deg, transparent 0%, transparent 62%, rgba(0,0,0,.08) 62%, rgba(0,0,0,.08) 68%, transparent 68%),
    /* 原球场细斜条 */
    repeating-linear-gradient(
      135deg,
      transparent 0,
      transparent 24rpx,
      rgba(255,255,255,.04) 24rpx,
      rgba(255,255,255,.04) 48rpx
    );
}

/* 角落里若隐若现的「足球」装饰(halftone 大圆 + 点)*/
.fan-banner::after {
  content: '⚽';
  position: absolute;
  right: -40rpx; bottom: -50rpx;
  font-size: 280rpx;
  line-height: 1;
  opacity: .12;
  transform: rotate(-18deg);
  pointer-events: none;
  filter: grayscale(.5) brightness(1.2);
}

.fan-banner-row {
  position: relative; z-index: 1;
  display: flex; align-items: center; gap: 24rpx;
}

.fan-flag-big {
  position: relative;
  font-size: 96rpx;
  width: 140rpx; height: 140rpx;
  display: inline-flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,.22);
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,.4);
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,.15);
  line-height: 1;
  transform: rotate(-6deg);
  animation: flagSwing 3.5s ease-in-out infinite;
}
@keyframes flagSwing {
  0%, 100% { transform: rotate(-6deg); }
  50%      { transform: rotate(4deg); }
}

/* === Cheer 应援大字 === */
.fan-cheer {
  display: block;
  font-family: 'Bebas Neue', 'Helvetica Neue', 'Inter', sans-serif;
  font-size: 54rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  line-height: 1;
  text-transform: uppercase;
  text-shadow:
    0 2rpx 0 rgba(0,0,0,.12),
    0 4rpx 12rpx rgba(0,0,0,.2);
  transform: rotate(-1deg);
}
.fan-cheer-empty {
  font-size: 64rpx;
  color: #14B8A6;
  letter-spacing: -1.5rpx;
  text-shadow:
    3rpx 3rpx 0 #FFD54A,
    6rpx 6rpx 0 rgba(20,184,166,.2);
  transform: rotate(-1.5deg);
}

.fan-sub {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  margin-top: 8rpx;
  letter-spacing: .5rpx;
}
.fan-sub-dark {
  color: #6B7280;
  margin-top: 10rpx;
}

/* === 未选阵营 · 空状态 · 俏皮 magazine 风 === */
.banner-empty {
  background:
    /* 顶部右上彩色光晕 */
    radial-gradient(circle at 90% 0%, rgba(255,107,125,.18) 0%, transparent 40%),
    /* 顶部左上金色光晕 */
    radial-gradient(circle at 0% 30%, rgba(255,213,74,.18) 0%, transparent 40%),
    /* 底部 emerald 光晕 */
    radial-gradient(circle at 50% 100%, rgba(20,184,166,.15) 0%, transparent 50%),
    linear-gradient(135deg, #FFFFFF 0%, #F0FDFA 100%);
  border: 2rpx solid rgba(20, 184, 166, .2);
  text-align: left;
}
.banner-empty .fan-banner-stripe {
  /* 空状态用浅色 halftone */
  background:
    radial-gradient(circle, rgba(20,184,166,.15) 2rpx, transparent 3rpx) 0 0 / 20rpx 20rpx,
    linear-gradient(118deg, transparent 0%, transparent 60%, rgba(255,213,74,.18) 60%, rgba(255,213,74,.18) 68%, transparent 68%);
}
.banner-empty::after {
  /* 空状态足球更彩 · 不灰度 */
  opacity: .18;
  filter: none;
  font-size: 240rpx;
  right: -30rpx; bottom: -40rpx;
}

/* === 快速选阵营 · 俏皮 bounce 动效 === */
.quick-pick-row {
  display: flex; gap: 18rpx;
  margin-top: 32rpx;
  overflow-x: auto;
  padding: 8rpx 4rpx 12rpx;
  position: relative; z-index: 1;
}
.quick-pick {
  flex-shrink: 0;
  display: flex; flex-direction: column; align-items: center; gap: 10rpx;
  cursor: pointer;
  animation: pickBounce .6s ease-out both;
}
.quick-pick:nth-child(1) { animation-delay: 0s; }
.quick-pick:nth-child(2) { animation-delay: .08s; }
.quick-pick:nth-child(3) { animation-delay: .16s; }
.quick-pick:nth-child(4) { animation-delay: .24s; }
.quick-pick:nth-child(5) { animation-delay: .32s; }
.quick-pick:nth-child(6) { animation-delay: .40s; }
@keyframes pickBounce {
  0%   { transform: translateY(20rpx) scale(.7); opacity: 0; }
  60%  { transform: translateY(-4rpx) scale(1.08); opacity: 1; }
  100% { transform: translateY(0) scale(1); }
}
.quick-pick-circle {
  width: 96rpx; height: 96rpx;
  border-radius: 50%;
  display: inline-flex; align-items: center; justify-content: center;
  border: 4rpx solid #FFFFFF;
  box-shadow:
    0 0 0 3rpx rgba(20, 184, 166, .12),
    0 6rpx 18rpx rgba(15, 23, 42, .18);
  transition: transform .2s cubic-bezier(.34, 1.7, .64, 1);
  position: relative;
}
.quick-pick:active .quick-pick-circle { transform: scale(.86) rotate(-6deg); }
.quick-pick-flag {
  font-size: 50rpx;
  line-height: 1;
  filter: drop-shadow(0 2rpx 4rpx rgba(0,0,0,.2));
  transform: rotate(-4deg);
}
.quick-pick:nth-child(even) .quick-pick-flag { transform: rotate(4deg); }
.quick-pick-more {
  background: #FFFFFF;
  border-color: #14B8A6;
  border-style: dashed;
  box-shadow:
    0 0 0 3rpx rgba(20, 184, 166, .15),
    0 6rpx 18rpx rgba(15, 23, 42, .12);
}
.quick-pick-more-tx {
  font-size: 56rpx; font-weight: 300; color: #14B8A6;
  line-height: 1;
}
.quick-pick-code {
  font-size: 20rpx; font-weight: 800; color: #4B5563;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

/* ============================================
   FAN STATS CARD(等级 / 已预测 / EDS / 关注)
   ============================================ */
.fan-stats-card {
  padding: 24rpx 20rpx;
  margin-bottom: 32rpx;
}
.fan-stat {
  flex: 1;
  display: flex; flex-direction: column; align-items: center; gap: 4rpx;
}
.fan-stat-val {
  font-family: 'Helvetica Neue', sans-serif;
  font-size: 38rpx; font-weight: 800;
  color: #14B8A6;
  letter-spacing: -.5rpx;
  line-height: 1;
}
.fan-stat-lbl {
  font-size: 20rpx; color: #9CA3AF;
}
.fan-stat-divider {
  width: 2rpx; height: 36rpx;
  background: #E5E7EB;
}

/* ============================================
   比赛卡 + Feed 卡(同前)
   ============================================ */
.match-card { padding: 24rpx 24rpx 22rpx; }
.match-top { margin-bottom: 16rpx; }
.match-countdown {
  font-size: 22rpx; color: #14B8A6; font-weight: 700;
  background: #ECFDF5;
  padding: 4rpx 12rpx; border-radius: 12rpx;
}
.match-teams {
  display: grid; grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 12rpx 0 16rpx;
  gap: 16rpx;
}
.team-name {
  margin-top: 10rpx;
  font-size: 26rpx; font-weight: 700;
  color: #111827;
  letter-spacing: .5rpx;
}
.match-vs {
  font-size: 24rpx; font-weight: 700;
  color: #9CA3AF; letter-spacing: 2rpx;
}
.match-bar { margin: 8rpx 0 14rpx; }
.match-foot {
  font-size: 22rpx;
  color: #9CA3AF;
}

.feed-item { padding: 22rpx 24rpx; margin-bottom: 16rpx; }
.feed-text {
  font-size: 28rpx;
  color: #1F2937;
  line-height: 1.55;
  margin-bottom: 12rpx;
}
.feed-pick {
  display: flex; align-items: center; gap: 12rpx;
  padding: 14rpx 18rpx;
  background: #F9FAFB;
  border-radius: 14rpx;
  margin: 12rpx 0;
  flex-wrap: wrap;
}
.feed-actions {
  padding-top: 12rpx;
  border-top: 2rpx solid #F4F6F5;
}
.feed-action {
  font-size: 22rpx; color: #9CA3AF;
}
.feed-action.tx-teal { color: #14B8A6; }

.empty-cta {
  text-align: center;
  padding: 24rpx;
  margin-top: 8rpx;
}
