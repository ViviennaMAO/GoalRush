<view class="page">

  <!-- ============================================
       Hero · 球迷应援 banner
       两种状态:
         1. 已选阵营 → 球队色渐变 + 母语应援口号大字
         2. 未选阵营 → 「PICK YOUR SIDE」 + 6 队快速选取
       ============================================ -->
  <view wx:if="{{myTeam}}" class="fan-banner banner-team"
        style="background: linear-gradient(135deg, {{myTeamData.c1}} 0%, {{myTeamData.c2}} 100%);">
    <view class="fan-banner-stripe"></view>
    <view class="fan-banner-row">
      <view class="fan-flag-big">{{myTeamData.flag}}</view>
      <view class="col" style="flex:1; gap: 8rpx;">
        <text class="fan-cheer" style="color: {{myTeamData.textOn}};">{{myTeamData.cheer}}</text>
        <text class="fan-sub" style="color: {{myTeamData.textOn}}; opacity: .8;">{{i18n.hp_your_team_fight}}</text>
      </view>
    </view>
  </view>

  <view wx:else class="fan-banner banner-empty">
    <view class="fan-banner-stripe"></view>
    <text class="fan-cheer fan-cheer-empty">{{i18n.hp_pick_side}}</text>
    <text class="fan-sub fan-sub-dark">{{i18n.hp_which_flag}}</text>

    <view class="quick-pick-row">
      <view wx:for="{{quickTeams}}" wx:key="code" class="quick-pick" bindtap="quickPick" data-code="{{item.code}}">
        <view class="quick-pick-circle" style="background: linear-gradient(135deg, {{item.c1}}, {{item.c2}});">
          <text class="quick-pick-flag">{{item.flag}}</text>
        </view>
        <text class="quick-pick-code">{{item.code}}</text>
      </view>
      <view class="quick-pick" bindtap="goAllTeams">
        <view class="quick-pick-circle quick-pick-more">
          <text class="quick-pick-more-tx">+</text>
        </view>
        <text class="quick-pick-code">{{i18n.cta_see_all}}</text>
      </view>
    </view>
  </view>

  <!-- ============================================
       球迷状态卡 · 等级 / 已预测 / EDS / 关注
       ============================================ -->
  <view class="card fan-stats-card">
    <view class="row-between" style="gap: 12rpx;">
      <view class="fan-stat">
        <text class="fan-stat-val">{{fanLevel}}</text>
        <text class="fan-stat-lbl">{{i18n.hp_stat_level}}</text>
      </view>
      <view class="fan-stat-divider"></view>
      <view class="fan-stat">
        <text class="fan-stat-val">{{predCount}}</text>
        <text class="fan-stat-lbl">{{i18n.hp_stat_picks}}</text>
      </view>
      <view class="fan-stat-divider"></view>
      <view class="fan-stat">
        <text class="fan-stat-val">{{eds}}</text>
        <text class="fan-stat-lbl">{{i18n.hp_stat_eds}}</text>
      </view>
      <view class="fan-stat-divider"></view>
      <view class="fan-stat">
        <text class="fan-stat-val">{{followCount}}</text>
        <text class="fan-stat-lbl">{{i18n.hp_stat_follows}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 今日比赛 ===== -->
  <view class="section">
    <view class="section-head">
      <view>
        <text class="section-title">{{i18n.hp_sec_today}}</text>
        <view class="section-sub">{{i18n.hp_sec_today_sub}}</view>
      </view>
      <text class="section-link" bindtap="goMatches">{{i18n.cta_see_all}} ›</text>
    </view>

    <view wx:for="{{todayMatches}}" wx:key="id" class="card match-card" bindtap="goMatch" data-id="{{item.id}}">
      <view class="row-between match-top">
        <text class="pill pill-light">{{item.competition}}</text>
        <text class="match-countdown">{{item.countdown}}</text>
      </view>
      <view class="match-teams">
        <view class="col-center">
          <view class="avatar avatar-lg"><text>{{item.homeTeam.flag}}</text></view>
          <text class="team-name">{{item.homeTeam.code}}</text>
        </view>
        <text class="match-vs">VS</text>
        <view class="col-center">
          <view class="avatar avatar-lg"><text>{{item.awayTeam.flag}}</text></view>
          <text class="team-name">{{item.awayTeam.code}}</text>
        </view>
      </view>
      <view class="bar-track match-bar">
        <view class="bar-seg home" style="width: {{item.distribution.home}}%;"></view>
        <view class="bar-seg draw" style="width: {{item.distribution.draw}}%;"></view>
        <view class="bar-seg away" style="width: {{item.distribution.away}}%;"></view>
      </view>
      <view class="row-between match-foot">
        <text class="tx-small">{{item.discussions}} {{i18n.mp_discussions_count}}</text>
        <text class="tx-small">{{i18n.pick_no_odds}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 球迷动态流 ===== -->
  <view class="section">
    <view class="section-head">
      <view>
        <text class="section-title">{{i18n.hp_sec_feed}}</text>
        <view class="section-sub">{{i18n.hp_sec_feed_sub}}</view>
      </view>
    </view>

    <view wx:for="{{feed}}" wx:key="id" class="card feed-item">

      <block wx:if="{{item.type === 'kol_pick'}}">
        <view class="row row-gap-md kol-tap" style="margin-bottom: 14rpx;" bindtap="goKol" data-id="{{item.kol}}">
          <view class="avatar avatar-md"><text>{{item.kolData.flag}}</text></view>
          <view class="col" style="flex: 1; gap: 4rpx;">
            <view class="row row-gap-sm">
              <text class="tx-bold">{{item.kolData.name}}</text>
              <text class="pill pill-teal">{{item.kolData.tier}}</text>
            </view>
            <text class="tx-small">{{item.kolData.handle}} · {{item.timeAgo}}</text>
          </view>
          <text class="tx-muted">›</text>
        </view>
        <view class="feed-text">{{item.text}}</view>
        <view class="feed-pick" bindtap="goMatch" data-id="{{item.match}}">
          <text class="tx-small">›</text>
          <text class="tx-bold tx-teal">
            {{item.matchData.homeTeam.flag}} {{item.matchData.homeTeam.code}}
            <text class="tx-mid"> vs </text>
            {{item.matchData.awayTeam.flag}} {{item.matchData.awayTeam.code}}
          </text>
          <text class="pill pill-light">{{item.pickLabel}}</text>
        </view>
        <view class="row row-gap-lg feed-actions">
          <text class="feed-action">{{i18n.feed_like}} {{item.likes}}</text>
          <text class="feed-action">{{i18n.feed_reply}} {{item.replies}}</text>
          <text class="feed-action tx-teal" bindtap="goMatch" data-id="{{item.match}}">{{i18n.feed_follow_pick_cta}}</text>
        </view>
      </block>

      <block wx:elif="{{item.type === 'group_buzz'}}">
        <view class="row row-gap-md" style="margin-bottom: 12rpx;">
          <view class="avatar avatar-md" style="background: #ECFDF5;"><text style="font-size:28rpx;color:#0F766E;">G</text></view>
          <view class="col" style="flex: 1; gap: 4rpx;">
            <text class="tx-bold">{{item.group}}</text>
            <text class="tx-small">{{item.members}} · {{item.timeAgo}}</text>
          </view>
          <text class="pill pill-light">{{i18n.feed_group_label}}</text>
        </view>
        <view class="feed-text">{{item.text}}</view>
        <view class="row row-gap-lg feed-actions">
          <text class="feed-action">{{i18n.feed_like}} {{item.likes || 0}}</text>
          <text class="feed-action tx-teal" bindtap="goMatch" data-id="{{item.match}}">{{i18n.feed_enter_group_cta}}</text>
        </view>
      </block>

      <block wx:elif="{{item.type === 'team_event'}}">
        <view class="row row-gap-md" style="margin-bottom: 12rpx;">
          <view class="avatar avatar-md"><text>{{item.teamData.flag}}</text></view>
          <view class="col" style="flex: 1; gap: 4rpx;">
            <text class="tx-bold">{{item.teamData.name}}</text>
            <text class="tx-small">{{item.timeAgo}}</text>
          </view>
        </view>
        <view class="feed-text">{{item.text}}</view>
        <view class="row row-gap-lg feed-actions">
          <text class="feed-action tx-teal" bindtap="goTeam" data-code="{{item.team}}">{{i18n.feed_enter_camp_cta}}</text>
        </view>
      </block>

      <block wx:elif="{{item.type === 'milestone'}}">
        <view class="row row-gap-md" style="margin-bottom: 0;">
          <view class="avatar avatar-md" style="background: #FEF3C7;"><text style="font-size: 28rpx; color: #92400E;">★</text></view>
          <view class="col" style="flex: 1; gap: 4rpx;">
            <text class="tx-bold">{{i18n.feed_milestone}}</text>
            <text class="tx-small">{{item.timeAgo}}</text>
          </view>
        </view>
        <view class="feed-text" style="margin-top: 12rpx;">{{item.text}}</view>
      </block>

    </view>

    <view class="card-flat card empty-cta" bindtap="goMatches" wx:if="{{feed.length}}">
      <text class="tx-teal tx-bold">{{i18n.hp_see_more}}</text>
    </view>
  </view>

  <view class="legal">
    <text>{{i18n.prof_legal_1}}</text>
    <text>{{i18n.prof_legal_2}}</text>
  </view>

</view>
