<view class="page">

  <!-- ===== 顶部 vs ===== -->
  <view class="card card-deep detail-hero">
    <text class="pill" style="background: rgba(255,255,255,.2); color: #fff;">{{match.competition}}</text>
    <view class="hero-vs-row">
      <view class="hero-team">
        <view class="avatar avatar-xl" style="background: rgba(255,255,255,.2);"><text>{{homeTeam.flag}}</text></view>
        <text class="hero-team-name">{{homeTeam.name}}</text>
        <text class="hero-team-code">{{homeTeam.code}}</text>
      </view>
      <view class="hero-vs-meta">
        <text class="hero-vs-tx">VS</text>
        <text class="hero-countdown">{{countdown}}</text>
        <text class="hero-kickoff">{{kickoffTxt}}</text>
      </view>
      <view class="hero-team">
        <view class="avatar avatar-xl" style="background: rgba(255,255,255,.2);"><text>{{awayTeam.flag}}</text></view>
        <text class="hero-team-name">{{awayTeam.name}}</text>
        <text class="hero-team-code">{{awayTeam.code}}</text>
      </view>
    </view>
    <view class="hero-venue">📍 {{match.venue}}</view>
  </view>

  <!-- ===== 我的预测 ===== -->
  <view class="section">
    <view class="section-head">
      <view>
        <text class="section-title">你的预测</text>
        <view class="section-sub">开赛前 5 分钟锁定 · 不押本金 · 命中得 EDS reward</view>
      </view>
    </view>

    <view class="row row-gap-md pick-row">
      <view class="pick {{userPick === 'home' ? 'selected' : ''}}" bindtap="onPick" data-pick="home">
        <view class="avatar"><text>{{homeTeam.flag}}</text></view>
        <text class="pick-team">{{homeTeam.code}} 赢</text>
        <text class="pick-pct">{{match.distribution.home}}% 玩家选</text>
      </view>
      <view class="pick {{userPick === 'draw' ? 'selected' : ''}}" bindtap="onPick" data-pick="draw">
        <view class="avatar"><text>🤝</text></view>
        <text class="pick-team">平局</text>
        <text class="pick-pct">{{match.distribution.draw}}% 玩家选</text>
      </view>
      <view class="pick {{userPick === 'away' ? 'selected' : ''}}" bindtap="onPick" data-pick="away">
        <view class="avatar"><text>{{awayTeam.flag}}</text></view>
        <text class="pick-team">{{awayTeam.code}} 赢</text>
        <text class="pick-pct">{{match.distribution.away}}% 玩家选</text>
      </view>
    </view>

    <view wx:if="{{userPick}}" class="card card-flat confirm-banner">
      <text class="tx-purple tx-bold">✓ 已押 {{pickLabel}}</text>
      <button class="btn btn-pill" style="background: #fff; color: #6D5BFF;" bindtap="onShare">📤 晒到群里</button>
    </view>
  </view>

  <!-- ===== KOL 在押 ===== -->
  <view class="section">
    <view class="section-head">
      <view>
        <text class="section-title">本场 KOL 在押</text>
        <view class="section-sub">一键跟随大 V 判断</view>
      </view>
    </view>

    <view wx:for="{{kols}}" wx:key="id" class="card kol-row" bindtap="goKol" data-id="{{item.id}}">
      <view class="avatar"><text>{{item.flag}}</text></view>
      <view class="col" style="flex: 1; gap: 4rpx;">
        <view class="row row-gap-sm">
          <text class="tx-bold">{{item.name}}</text>
          <text class="pill pill-purple">{{item.tier}}</text>
        </view>
        <text class="tx-small">{{item.handle}} · 命中率 {{item.hit_rate}}%</text>
      </view>
      <view class="kol-pick-pill" data-id="{{item.id}}" catchtap="followKol">
        <text class="tx-purple tx-bold">跟押 {{item.pickLabel}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 实时讨论 · 弹幕 ===== -->
  <view class="section">
    <view class="section-head">
      <view>
        <text class="section-title">实时讨论 💬</text>
        <view class="section-sub">{{match.discussions}} 位球迷在聊</view>
      </view>
      <text class="section-link" bindtap="onShare">分享给群友</text>
    </view>

    <view wx:for="{{discussions}}" wx:key="ts_min" class="card discuss-row">
      <view class="avatar avatar-sm"><text>{{item.flag}}</text></view>
      <view class="col" style="flex: 1; gap: 6rpx;">
        <view class="row row-gap-sm">
          <text class="tx-bold" style="font-size: 26rpx;">{{item.user}}</text>
          <text wx:if="{{item.kol}}" class="pill pill-purple" style="font-size: 18rpx; height: 32rpx; padding: 0 12rpx;">KOL</text>
          <text wx:if="{{item.team}}" class="tx-small">· 支持 {{item.team}}</text>
          <text class="tx-small">· {{item.ago}}</text>
        </view>
        <text class="discuss-text">{{item.text}}</text>
      </view>
    </view>

    <view class="card empty-discuss" bindtap="onShare">
      <text class="tx-purple tx-bold">+ 加群一起聊</text>
      <text class="tx-small" style="margin-top: 8rpx;">分享到 IM 群组,5 友进群 = 500 EDS</text>
    </view>
  </view>

  <view class="legal">
    <text>玩家分布百分比仅作社交参考 · 不是赔率 · 不构成投资建议</text>
    <text>结算靠 SofaScore + API-Football + ESPN 三源对账 · 命中 5 分钟内 EDS 到账</text>
    <text>GoalRush · Powered by Luffa · Operated within a group holding HK SFC licenses</text>
  </view>

</view>
