<view class="page">

  <!-- ============================================
       GOAL! 全屏庆祝(F-P0-2 · v2 PRD §3.2)
       触发后 3 秒自动消失 · 用户点击可提前关闭
       ============================================ -->
  <view wx:if="{{showGoal}}" class="goal-overlay" catchtap="hideGoal">
    <view class="goal-bg-pulse" style="background: linear-gradient(135deg, {{goalC1}} 0%, {{goalC2}} 100%);"></view>

    <!-- 30 颗 confetti(球队色 + 中性色 mix) -->
    <view wx:for="{{confetti}}" wx:key="i" wx:for-item="c" class="confetti"
          style="left: {{c.x}}%; background: {{c.color}}; animation-delay: {{c.delay}}s; animation-duration: {{c.dur}}s; width: {{c.w}}rpx; height: {{c.h}}rpx;"></view>

    <view class="goal-content" catchtap="noop">
      <view class="goal-flag-row">
        <text class="goal-flag-big">{{goalTeamFlag}}</text>
      </view>
      <text class="goal-text" style="color: {{goalTextOn}};">{{i18n.goal_text}}</text>
      <text class="goal-team" style="color: {{goalTextOn}}; opacity: .92;">{{goalScoreLabel}}</text>
      <text wx:if="{{goalScorer}}" class="goal-scorer" style="color: {{goalTextOn}}; opacity: .7;">{{i18n.goal_scorer_label}} · {{goalScorer}}</text>

      <view class="goal-actions">
        <button class="btn btn-primary" catchtap="shareGoal">{{i18n.goal_share}}</button>
        <button class="btn btn-ghost" style="background: rgba(255,255,255,.18); color: #fff;" catchtap="hideGoal">{{i18n.goal_close}}</button>
      </view>
    </view>
  </view>

  <!-- ===== 顶部 vs(白底 · 大比分式 hero) ===== -->
  <view class="card detail-hero">
    <view class="detail-comp">{{match.competition}}</view>
    <view class="hero-vs-row">
      <view class="hero-team">
        <view class="avatar avatar-xl avatar-ring"><text>{{homeTeam.flag}}</text></view>
        <text class="hero-team-name">{{homeTeam.name}}</text>
        <text class="hero-team-code">{{homeTeam.code}}</text>
      </view>
      <view class="hero-vs-meta">
        <text class="hero-vs-tx">VS</text>
        <text class="hero-countdown">{{countdown}}</text>
        <text class="hero-kickoff">{{kickoffTxt}}</text>
      </view>
      <view class="hero-team">
        <view class="avatar avatar-xl avatar-ring"><text>{{awayTeam.flag}}</text></view>
        <text class="hero-team-name">{{awayTeam.name}}</text>
        <text class="hero-team-code">{{awayTeam.code}}</text>
      </view>
    </view>
    <view class="pitch-mini"></view>
    <view class="hero-venue">{{match.venue}}</view>

    <!-- DEMO · 模拟进球触发器(生产环境去掉 · 真实由 SofaScore polling 驱动) -->
    <view class="demo-trigger" bindtap="demoGoal">
      <text class="demo-trigger-tx">▶ {{i18n.goal_demo_trigger}}</text>
    </view>
  </view>

  <!-- ===== 我的预测 ===== -->
  <view class="section">
    <view class="section-head">
      <view>
        <text class="section-title">{{i18n.md_your_pick_title}}</text>
        <view class="section-sub">{{i18n.md_your_pick_sub}}</view>
      </view>
    </view>

    <view class="row row-gap-md pick-row">
      <view class="pick {{userPick === 'home' ? 'selected' : ''}}" bindtap="onPick" data-pick="home">
        <view class="avatar"><text>{{homeTeam.flag}}</text></view>
        <text class="pick-team">{{i18n.pick_home_win}}</text>
        <text class="pick-pct">{{match.distribution.home}}{{i18n.pick_players_chose}}</text>
      </view>
      <view class="pick {{userPick === 'draw' ? 'selected' : ''}}" bindtap="onPick" data-pick="draw">
        <view class="avatar"><text>🤝</text></view>
        <text class="pick-team">{{i18n.pick_draw}}</text>
        <text class="pick-pct">{{match.distribution.draw}}{{i18n.pick_players_chose}}</text>
      </view>
      <view class="pick {{userPick === 'away' ? 'selected' : ''}}" bindtap="onPick" data-pick="away">
        <view class="avatar"><text>{{awayTeam.flag}}</text></view>
        <text class="pick-team">{{i18n.pick_away_win}}</text>
        <text class="pick-pct">{{match.distribution.away}}{{i18n.pick_players_chose}}</text>
      </view>
    </view>

    <view wx:if="{{userPick}}" class="confirm-banner">
      <text class="tx-bold" style="color:#fff;">✓ {{pickLabel}}</text>
      <button class="btn btn-pill" style="background: #fff; color: #0F766E;" bindtap="onShare">{{i18n.cta_share_group}}</button>
    </view>
  </view>

  <!-- ===== KOL 在押 ===== -->
  <view class="section">
    <view class="section-head">
      <view>
        <text class="section-title">{{i18n.md_kol_title}}</text>
        <view class="section-sub">{{i18n.md_kol_sub}}</view>
      </view>
    </view>

    <view wx:for="{{kols}}" wx:key="id" class="card kol-row" bindtap="goKol" data-id="{{item.id}}">
      <view class="avatar"><text>{{item.flag}}</text></view>
      <view class="col" style="flex: 1; gap: 4rpx;">
        <view class="row row-gap-sm">
          <text class="tx-bold">{{item.name}}</text>
          <text class="pill pill-teal">{{item.tier}}</text>
        </view>
        <text class="tx-small">{{item.handle}} · {{item.hit_rate}}%</text>
      </view>
      <view class="kol-pick-pill" data-id="{{item.id}}" catchtap="followKol">
        <text class="tx-teal tx-bold">{{i18n.md_kol_follow_pick}} {{item.pickLabel}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 实时讨论 · 弹幕 ===== -->
  <view class="section">
    <view class="section-head">
      <view>
        <text class="section-title">{{i18n.md_chat_title}}</text>
        <view class="section-sub">{{match.discussions}} {{i18n.md_chat_sub_n}}</view>
      </view>
      <text class="section-link" bindtap="onShare">{{i18n.cta_share}}</text>
    </view>

    <view wx:for="{{discussions}}" wx:key="ts_min" class="card discuss-row">
      <view class="avatar avatar-sm"><text>{{item.flag}}</text></view>
      <view class="col" style="flex: 1; gap: 6rpx;">
        <view class="row row-gap-sm">
          <text class="tx-bold" style="font-size: 26rpx;">{{item.user}}</text>
          <text wx:if="{{item.kol}}" class="pill pill-teal" style="font-size: 18rpx; height: 32rpx; padding: 0 12rpx;">KOL</text>
          <text class="tx-small">· {{item.ago}}</text>
        </view>
        <text class="discuss-text">{{item.text}}</text>
      </view>
    </view>

    <view class="empty-discuss" bindtap="onShare">
      <text class="tx-teal tx-bold">{{i18n.md_chat_join_cta}}</text>
      <text class="tx-small" style="margin-top: 8rpx;">{{i18n.md_chat_join_sub}}</text>
    </view>
  </view>

  <view class="legal">
    <text>{{i18n.md_legal_1}}</text>
    <text>{{i18n.md_legal_2}}</text>
    <text>{{i18n.prof_legal_2}}</text>
  </view>

</view>
