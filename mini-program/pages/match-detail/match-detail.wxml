<view class="page">

  <!-- ============================================
       GOAL! 全屏庆祝(F-P0-2 · v2 PRD §3.2)
       触发后 3 秒自动消失 · 用户点击可提前关闭
       ============================================ -->
  <view wx:if="{{showGoal}}" class="goal-overlay" catchtap="hideGoal">
    <view class="goal-bg-pulse" style="background: linear-gradient(135deg, {{goalC1}} 0%, {{goalC2}} 100%);"></view>

    <!-- 30 颗 confetti(球队色 + 中性色 mix) -->
    <view wx:for="{{confetti}}" wx:key="i" wx:for-item="c" class="confetti"
          style="left: {{c.x}}%; background: {{c.color}}; animation-delay: {{c.delay}}s; animation-duration: {{c.dur}}s; width: {{c.w}}rpx; height: {{c.h}}rpx;"></view>

    <view class="goal-content" catchtap="noop">
      <view class="goal-flag-row">
        <text class="goal-flag-big">{{goalTeamFlag}}</text>
      </view>
      <text class="goal-text" style="color: {{goalTextOn}};">{{i18n.goal_text}}</text>
      <text class="goal-team" style="color: {{goalTextOn}}; opacity: .92;">{{goalScoreLabel}}</text>
      <text wx:if="{{goalScorer}}" class="goal-scorer" style="color: {{goalTextOn}}; opacity: .7;">{{i18n.goal_scorer_label}} · {{goalScorer}}</text>

      <view class="goal-actions">
        <button class="btn btn-primary" catchtap="shareGoal">{{i18n.goal_share}}</button>
        <button class="btn btn-ghost" style="background: rgba(255,255,255,.18); color: #fff;" catchtap="hideGoal">{{i18n.goal_close}}</button>
      </view>
    </view>
  </view>

  <!-- ===== 顶部 vs(白底 · 大比分式 hero) ===== -->
  <view class="card detail-hero">
    <view class="detail-comp">{{match.competition}}</view>
    <view class="hero-vs-row">
      <view class="hero-team">
        <view class="avatar avatar-xl avatar-ring"><text>{{homeTeam.flag}}</text></view>
        <text class="hero-team-name">{{homeTeam.name}}</text>
        <text class="hero-team-code">{{homeTeam.code}}</text>
      </view>
      <view class="hero-vs-meta">
        <text class="hero-vs-tx">VS</text>
        <text class="hero-countdown">{{countdown}}</text>
        <text class="hero-kickoff">{{kickoffTxt}}</text>
      </view>
      <view class="hero-team">
        <view class="avatar avatar-xl avatar-ring"><text>{{awayTeam.flag}}</text></view>
        <text class="hero-team-name">{{awayTeam.name}}</text>
        <text class="hero-team-code">{{awayTeam.code}}</text>
      </view>
    </view>
    <view class="pitch-mini"></view>
    <view class="hero-venue">{{match.venue}}</view>

    <!-- DEMO 触发器组(生产环境去掉 · 真实由 SofaScore polling 驱动) -->
    <view class="demo-triggers">
      <view class="demo-trigger" bindtap="demoGoal">
        <text class="demo-trigger-tx">▶ {{i18n.goal_demo_trigger}}</text>
      </view>
      <view class="demo-trigger" bindtap="demoHalftime">
        <text class="demo-trigger-tx">▶ {{i18n.ht_cta_demo}}</text>
      </view>
    </view>
  </view>

  <!-- ============================================
       F-P0-3 半场重押 overlay(60 秒 / 30 EDS)
       触发:half-time 检测(真实) / demo 按钮(开发)
       约束:必须押过主预测才开放(防套利)
       ============================================ -->
  <view wx:if="{{showHt}}" class="ht-overlay">
    <view class="ht-card">
      <view class="ht-head">
        <text class="ht-title">{{i18n.ht_title}}</text>
        <text class="ht-meta">{{homeTeam.code}} {{htCurrentScore}} {{awayTeam.code}}</text>
      </view>

      <text class="ht-subtitle">{{i18n.ht_subtitle}}</text>

      <!-- 60s 倒计时进度条 -->
      <view class="ht-countdown-row">
        <view class="ht-countdown-bar">
          <view class="ht-countdown-fill" style="width: {{htProgress}}%;"></view>
        </view>
        <text class="ht-countdown-sec">{{htSecondsLeft}}s</text>
      </view>

      <!-- 5 个比分选项 -->
      <view class="ht-options">
        <view wx:for="{{htOptions}}" wx:key="key"
              class="ht-opt {{htPick === item.key ? 'selected' : ''}}"
              bindtap="htPickOption" data-key="{{item.key}}">
          <text class="ht-opt-label">{{item.label}}</text>
          <text wx:if="{{item.friendCount}}" class="ht-opt-friends">{{item.friendCount}}</text>
        </view>
      </view>

      <!-- 群友同押社交反馈 -->
      <view wx:if="{{htSocialText}}" class="ht-social">
        <text class="tx-small tx-mid">{{htSocialText}}</text>
      </view>

      <view class="ht-actions">
        <button class="btn btn-ghost" bindtap="htSkip">{{i18n.ht_cta_skip}}</button>
        <button class="btn btn-primary {{!htPick ? 'is-disabled' : ''}}"
                disabled="{{!htPick}}" bindtap="htConfirm">{{i18n.ht_cta_confirm}}</button>
      </view>
    </view>
  </view>

  <!-- ===== 我的预测 ===== -->
  <view class="section">
    <view class="section-head">
      <view>
        <text class="section-title">{{i18n.md_your_pick_title}}</text>
        <view class="section-sub">{{i18n.md_your_pick_sub}}</view>
      </view>
    </view>

    <view class="row row-gap-md pick-row">
      <view class="pick {{userPick === 'home' ? 'selected' : ''}}" bindtap="onPick" data-pick="home">
        <view class="avatar"><text>{{homeTeam.flag}}</text></view>
        <text class="pick-team">{{i18n.pick_home_win}}</text>
        <text class="pick-pct">{{match.distribution.home}}{{i18n.pick_players_chose}}</text>
      </view>
      <view class="pick {{userPick === 'draw' ? 'selected' : ''}}" bindtap="onPick" data-pick="draw">
        <view class="avatar"><text>🤝</text></view>
        <text class="pick-team">{{i18n.pick_draw}}</text>
        <text class="pick-pct">{{match.distribution.draw}}{{i18n.pick_players_chose}}</text>
      </view>
      <view class="pick {{userPick === 'away' ? 'selected' : ''}}" bindtap="onPick" data-pick="away">
        <view class="avatar"><text>{{awayTeam.flag}}</text></view>
        <text class="pick-team">{{i18n.pick_away_win}}</text>
        <text class="pick-pct">{{match.distribution.away}}{{i18n.pick_players_chose}}</text>
      </view>
    </view>

    <view wx:if="{{userPick}}" class="confirm-banner">
      <text class="tx-bold" style="color:#fff;">✓ {{pickLabel}}</text>
      <button class="btn btn-pill" style="background: #fff; color: #0F766E;" bindtap="onShare">{{i18n.cta_share_group}}</button>
    </view>

    <!-- ============================================
         F-P0-4 Bold Call 加倍开关
         仅当用户选择的项分布 < 25%(冷门)时可勾
         ============================================ -->
    <view wx:if="{{userPick}}" class="bold-call {{boldEligible ? '' : 'is-disabled'}}">
      <view class="row-between">
        <view class="col" style="gap: 4rpx; flex: 1;">
          <view class="row row-gap-sm">
            <text class="bold-call-label">{{i18n.adv_toggle}}</text>
            <text class="pill {{boldEligible ? 'pill-gold' : 'pill-light'}}">×5</text>
          </view>
          <text class="tx-small">{{boldEligible ? i18n.adv_sub : i18n.adv_toggle_off_hint}}</text>
        </view>
        <switch checked="{{isBold}}" disabled="{{!boldEligible}}" bindchange="toggleBold" color="#14B8A6"></switch>
      </view>
    </view>

    <!-- 进阶预测折叠 -->
    <view wx:if="{{userPick}}" class="adv-section">
      <view class="adv-toggle-row" bindtap="toggleAdvShow">
        <text class="tx-teal tx-bold">{{showAdv ? i18n.adv_hide_more : i18n.adv_show_more}}</text>
        <text class="adv-chevron {{showAdv ? 'is-open' : ''}}">⌄</text>
      </view>

      <view wx:if="{{showAdv}}" class="adv-panel">

        <!-- 1. 精确比分 -->
        <view class="adv-block">
          <text class="adv-block-title">{{i18n.adv_score_title}}</text>
          <view class="adv-grid adv-grid-6">
            <view wx:for="{{advScoreOptions}}" wx:key="key"
                  class="adv-cell {{advScorePick === item.key ? 'selected' : ''}}"
                  bindtap="pickAdvScore" data-key="{{item.key}}">
              <text>{{item.key}}</text>
            </view>
          </view>
        </view>

        <!-- 2. 首球者 -->
        <view class="adv-block">
          <text class="adv-block-title">{{i18n.adv_first_scorer_title}}</text>
          <view class="adv-grid adv-grid-3">
            <view class="adv-cell {{advFirstScorer === 'home' ? 'selected' : ''}}"
                  bindtap="pickAdvFirst" data-key="home">
              <text>{{homeTeam.flag}} {{homeTeam.code}}</text>
            </view>
            <view class="adv-cell {{advFirstScorer === 'away' ? 'selected' : ''}}"
                  bindtap="pickAdvFirst" data-key="away">
              <text>{{awayTeam.flag}} {{awayTeam.code}}</text>
            </view>
            <view class="adv-cell {{advFirstScorer === 'none' ? 'selected' : ''}}"
                  bindtap="pickAdvFirst" data-key="none">
              <text>{{i18n.adv_no_first_scorer}}</text>
            </view>
          </view>
        </view>

        <!-- 3. 红牌数 -->
        <view class="adv-block">
          <text class="adv-block-title">{{i18n.adv_cards_title}}</text>
          <view class="adv-grid adv-grid-3">
            <view class="adv-cell {{advCards === '0' ? 'selected' : ''}}" bindtap="pickAdvCards" data-key="0">
              <text>{{i18n.adv_cards_0}}</text>
            </view>
            <view class="adv-cell {{advCards === '1' ? 'selected' : ''}}" bindtap="pickAdvCards" data-key="1">
              <text>{{i18n.adv_cards_1}}</text>
            </view>
            <view class="adv-cell {{advCards === '2+' ? 'selected' : ''}}" bindtap="pickAdvCards" data-key="2+">
              <text>{{i18n.adv_cards_2plus}}</text>
            </view>
          </view>
        </view>

        <!-- Judgment Score 累计预览 -->
        <view wx:if="{{judgmentScore}}" class="adv-judgment">
          <text class="tx-small">{{i18n.adv_judgment_score}}</text>
          <text class="adv-judgment-val">{{judgmentScore}}</text>
        </view>

      </view>
    </view>

  </view>

  <!-- ===== KOL 在押 ===== -->
  <view class="section">
    <view class="section-head">
      <view>
        <text class="section-title">{{i18n.md_kol_title}}</text>
        <view class="section-sub">{{i18n.md_kol_sub}}</view>
      </view>
    </view>

    <view wx:for="{{kols}}" wx:key="id" class="card kol-row" bindtap="goKol" data-id="{{item.id}}">
      <view class="avatar"><text>{{item.flag}}</text></view>
      <view class="col" style="flex: 1; gap: 4rpx;">
        <view class="row row-gap-sm">
          <text class="tx-bold">{{item.name}}</text>
          <text class="pill pill-teal">{{item.tier}}</text>
        </view>
        <text class="tx-small">{{item.handle}} · {{item.hit_rate}}%</text>
      </view>
      <view class="kol-pick-pill" data-id="{{item.id}}" catchtap="followKol">
        <text class="tx-teal tx-bold">{{i18n.md_kol_follow_pick}} {{item.pickLabel}}</text>
      </view>
    </view>
  </view>

  <!-- ============================================
       F-P0-1 实时聊天室 + 阵营色识别
       前端 mock 真实场景:Ken 后端 WebSocket 推送
       Mock 模拟:每 8-12s 从 CHAT_MOCK_POOL 注入一条
       ============================================ -->
  <view class="section chat-section">
    <view class="section-head">
      <view>
        <text class="section-title">{{i18n.md_chat_title}}</text>
        <view class="section-sub">
          <text class="live-dot"></text>
          {{watching}} {{i18n.chat_watching}}
        </view>
      </view>
      <text class="section-link" bindtap="onShare">{{i18n.cta_share}}</text>
    </view>

    <scroll-view class="chat-scroll" scroll-y scroll-into-view="{{lastMessageId}}" scroll-with-animation>
      <view wx:if="{{!chatMessages.length}}" class="chat-empty">
        <text class="tx-muted">{{i18n.chat_no_messages}}</text>
      </view>

      <view wx:for="{{chatMessages}}" wx:key="id" id="{{item.scrollAnchor}}"
            class="chat-bubble {{item.isMine ? 'is-mine' : ''}} {{item.isMyCamp ? 'is-my-camp' : ''}} {{item.isOpponent ? 'is-opponent' : ''}}">
        <view wx:if="{{!item.isMine}}" class="avatar avatar-sm"><text>{{item.flag}}</text></view>
        <view class="chat-bubble-body" style="border-left-color: {{item.campColor || 'transparent'}};">
          <view wx:if="{{!item.isMine}}" class="row row-gap-sm" style="margin-bottom: 4rpx;">
            <text class="chat-user-name">{{item.user}}</text>
            <text wx:if="{{item.kol}}" class="pill pill-teal" style="font-size: 18rpx; height: 28rpx; padding: 0 10rpx;">{{i18n.chat_kol_tag}}</text>
            <text wx:if="{{item.campCode && !item.isMine}}" class="tx-small">· {{item.campCode}}</text>
            <text class="tx-small">· {{item.timeTxt}}</text>
          </view>
          <text class="chat-text">{{item.text}}</text>
        </view>
        <view wx:if="{{item.isMine}}" class="avatar avatar-sm"><text>{{myFlag || '⚽'}}</text></view>
      </view>
    </scroll-view>

    <!-- Reaction bar(快速反应)-->
    <view class="chat-reactions">
      <view wx:for="{{reactions}}" wx:key="*this" wx:for-item="r" class="reaction-btn" bindtap="sendReaction" data-r="{{r}}">
        <text>{{r}}</text>
      </view>
    </view>

    <!-- 输入栏 -->
    <view class="chat-input-row">
      <view wx:if="{{!hasCamp}}" class="chat-input chat-input-locked" bindtap="onPickTeam">
        <text class="tx-muted">{{i18n.chat_camp_required}} →</text>
      </view>
      <block wx:else>
        <input class="chat-input"
               value="{{chatDraft}}"
               placeholder="{{i18n.chat_placeholder}}"
               bindinput="onDraftInput"
               confirm-type="send"
               bindconfirm="sendMessage"
               maxlength="120" />
        <button class="chat-send-btn {{chatDraft ? 'is-ready' : ''}}" bindtap="sendMessage" disabled="{{!chatDraft}}">
          {{i18n.chat_send}}
        </button>
      </block>
    </view>
  </view>

  <view class="legal">
    <text>{{i18n.md_legal_1}}</text>
    <text>{{i18n.md_legal_2}}</text>
    <text>{{i18n.prof_legal_2}}</text>
  </view>

</view>
