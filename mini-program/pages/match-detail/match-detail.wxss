/* ============================================
   GOAL! 全屏庆祝(F-P0-2)
   触发瞬间:多巴胺爆发 + 球队色脉冲 + confetti 雨
   ============================================ */
.goal-overlay {
  position: fixed; inset: 0;
  z-index: 9999;
  display: flex; align-items: center; justify-content: center;
  background: rgba(0,0,0,.55);
  overflow: hidden;
  animation: fadeIn .25s ease-out;
}
@keyframes fadeIn { from { opacity: 0 } to { opacity: 1 } }

.goal-bg-pulse {
  position: absolute; inset: 0;
  opacity: .85;
  animation: bgPulse 1.2s ease-in-out infinite;
}
@keyframes bgPulse {
  0%, 100% { transform: scale(1); opacity: .8; }
  50% { transform: scale(1.08); opacity: .9; }
}

.confetti {
  position: absolute;
  top: -60rpx;
  border-radius: 4rpx;
  animation: confettiFall linear forwards;
  z-index: 1;
}
@keyframes confettiFall {
  0%   { transform: translateY(0) rotate(0deg);    opacity: 1; }
  60%  { opacity: 1; }
  100% { transform: translateY(140vh) rotate(720deg); opacity: 0; }
}

.goal-content {
  position: relative; z-index: 2;
  text-align: center;
  padding: 60rpx 40rpx;
  max-width: 90vw;
  animation: goalIn .55s cubic-bezier(.22,1.5,.36,1) both;
}
@keyframes goalIn {
  0%   { transform: scale(.4); opacity: 0; }
  60%  { transform: scale(1.12); opacity: 1; }
  100% { transform: scale(1); }
}

.goal-flag-row {
  margin-bottom: 24rpx;
  animation: flagWiggle .8s ease-in-out infinite;
}
@keyframes flagWiggle {
  0%, 100% { transform: rotate(-3deg); }
  50% { transform: rotate(3deg); }
}
.goal-flag-big {
  font-size: 180rpx;
  line-height: 1;
  filter: drop-shadow(0 8rpx 24rpx rgba(0,0,0,.4));
}

.goal-text {
  display: block;
  font-family: 'Bebas Neue', 'Helvetica Neue', sans-serif;
  font-size: 220rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
  line-height: 1;
  text-shadow: 0 6rpx 24rpx rgba(0,0,0,.35);
  margin-bottom: 16rpx;
}
.goal-team {
  display: block;
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  margin-top: 12rpx;
  text-shadow: 0 3rpx 12rpx rgba(0,0,0,.3);
}
.goal-scorer {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 12rpx;
  letter-spacing: 1rpx;
}

.goal-actions {
  display: flex;
  gap: 16rpx;
  justify-content: center;
  margin-top: 48rpx;
}
.goal-actions .btn {
  min-width: 220rpx;
}

/* DEMO 触发按钮(开发期可见 · 生产环境隐藏)*/
.demo-triggers {
  display: flex; flex-direction: column; gap: 10rpx;
  margin-top: 20rpx;
}
.demo-trigger {
  padding: 14rpx 20rpx;
  background: rgba(20, 184, 166, .08);
  border: 2rpx dashed rgba(20, 184, 166, .4);
  border-radius: 14rpx;
  text-align: center;
}
.demo-trigger-tx {
  font-size: 22rpx; color: #0F766E; font-weight: 600;
  letter-spacing: .5rpx;
}

/* ============================================
   F-P0-3 半场重押 overlay
   ============================================ */
.ht-overlay {
  position: fixed; inset: 0;
  z-index: 9998;
  background: rgba(0,0,0,.6);
  backdrop-filter: blur(8rpx);
  display: flex; align-items: center; justify-content: center;
  padding: 32rpx;
  animation: fadeIn .25s ease-out;
}
.ht-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 36rpx 32rpx;
  width: 100%;
  max-width: 640rpx;
  box-shadow: 0 24rpx 64rpx rgba(0,0,0,.3);
  animation: htCardIn .35s cubic-bezier(.22,1.4,.36,1) both;
}
@keyframes htCardIn {
  0%   { transform: translateY(40rpx) scale(.96); opacity: 0; }
  100% { transform: translateY(0) scale(1); opacity: 1; }
}

.ht-head {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 8rpx;
}
.ht-title {
  font-family: 'Bebas Neue', 'Helvetica Neue', sans-serif;
  font-size: 44rpx; font-weight: 900;
  color: #14B8A6; letter-spacing: 2rpx;
}
.ht-meta {
  font-size: 26rpx; font-weight: 700; color: #1F2937;
  font-family: 'Helvetica Neue', sans-serif;
}
.ht-subtitle {
  font-size: 24rpx; color: #6B7280;
  display: block;
  margin-bottom: 24rpx;
}

/* 倒计时 */
.ht-countdown-row {
  display: flex; align-items: center; gap: 16rpx;
  margin-bottom: 28rpx;
}
.ht-countdown-bar {
  flex: 1; height: 12rpx;
  background: #F3F4F6;
  border-radius: 6rpx; overflow: hidden;
}
.ht-countdown-fill {
  height: 100%;
  background: linear-gradient(90deg, #14B8A6, #5EEAD4);
  transition: width .98s linear;
  border-radius: 6rpx;
}
.ht-countdown-sec {
  font-family: 'JetBrains Mono', ui-monospace, Menlo, monospace;
  font-size: 28rpx; font-weight: 800; color: #14B8A6;
  min-width: 60rpx; text-align: right;
}

/* 5 个比分选项 */
.ht-options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 20rpx;
}
.ht-opt {
  position: relative;
  background: #F4F6F5;
  border: 4rpx solid transparent;
  border-radius: 18rpx;
  padding: 24rpx 0;
  text-align: center;
  transition: all .15s;
}
.ht-opt.selected {
  background: #ECFDF5;
  border-color: #14B8A6;
  box-shadow: 0 6rpx 18rpx rgba(20, 184, 166, .2);
}
.ht-opt-label {
  font-family: 'Helvetica Neue', sans-serif;
  font-size: 36rpx; font-weight: 800;
  color: #1F2937;
  letter-spacing: -.5rpx;
}
.ht-opt.selected .ht-opt-label {
  color: #0F766E;
}
.ht-opt-friends {
  position: absolute; top: 6rpx; right: 10rpx;
  font-size: 18rpx; font-weight: 700; color: #14B8A6;
  background: rgba(20, 184, 166, .12);
  padding: 2rpx 8rpx; border-radius: 8rpx;
  font-family: ui-monospace, Menlo, monospace;
}

/* 社交反馈 */
.ht-social {
  text-align: center;
  padding: 12rpx 0;
}

/* Actions */
.ht-actions {
  display: flex; gap: 12rpx;
  margin-top: 12rpx;
}
.ht-actions .btn { flex: 1; }
.ht-actions .btn.is-disabled {
  opacity: 0.45; box-shadow: none;
}

/* 比赛详情 · 大比分 hero(参考截图 3:Brazil 2 : 4 Italy)*/
.detail-hero {
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
}
.detail-comp {
  font-size: 22rpx; color: #9CA3AF;
  text-transform: uppercase; letter-spacing: 1rpx;
  text-align: center;
  margin-bottom: 20rpx;
}
.hero-vs-row {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 12rpx;
}
.hero-team {
  display: flex; flex-direction: column; align-items: center; gap: 12rpx;
}
.hero-team-name { font-size: 22rpx; color: #6B7280; font-weight: 600; }
.hero-team-code {
  font-size: 30rpx; font-weight: 800; color: #111827; letter-spacing: 1rpx;
}
.hero-vs-meta {
  display: flex; flex-direction: column; align-items: center; gap: 8rpx;
}
.hero-vs-tx {
  font-size: 60rpx; font-weight: 800;
  color: #111827; letter-spacing: 2rpx;
  font-family: 'Helvetica Neue', sans-serif;
}
.hero-countdown {
  font-size: 22rpx; font-weight: 700; color: #14B8A6;
  background: #ECFDF5;
  padding: 6rpx 14rpx; border-radius: 12rpx;
  font-family: ui-monospace, Menlo, monospace;
}
.hero-kickoff {
  font-size: 20rpx; color: #9CA3AF;
}
.hero-venue {
  margin-top: 20rpx;
  font-size: 22rpx; color: #9CA3AF;
  text-align: center;
}

/* ===== Pick row ===== */
.pick-row {
  display: flex; flex-direction: row; gap: 14rpx;
}
.pick {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 26rpx 14rpx;
  display: flex; flex-direction: column; align-items: center; gap: 10rpx;
  border: 4rpx solid transparent;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.03);
  transition: all .15s;
}
.pick.selected {
  border-color: #14B8A6;
  background: #F0FDFA;
  box-shadow: 0 6rpx 20rpx rgba(20, 184, 166, .15);
}
.pick-team {
  font-size: 26rpx; font-weight: 700; color: #1F2937;
  margin-top: 4rpx;
}
.pick.selected .pick-team { color: #0F766E; }
.pick-pct { font-size: 20rpx; color: #9CA3AF; }

.confirm-banner {
  background: #14B8A6;
  color: #fff;
  display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
  padding: 18rpx 26rpx;
  margin-top: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(20, 184, 166, .25);
}
.confirm-banner .tx-teal { color: #fff; }

/* ===== KOL row ===== */
.kol-row {
  display: flex; align-items: center; gap: 16rpx;
  padding: 18rpx 22rpx;
}
.kol-pick-pill {
  background: #ECFDF5;
  padding: 12rpx 20rpx;
  border-radius: 26rpx;
}

/* ============================================
   F-P0-1 实时聊天室
   ============================================ */
.chat-section { margin-top: 36rpx; }

/* LIVE dot pulse · 红色实时感 */
.live-dot {
  display: inline-block;
  width: 12rpx; height: 12rpx;
  border-radius: 50%;
  background: #FF6B7D;
  margin-right: 8rpx;
  animation: liveDot 1.4s ease-in-out infinite;
  box-shadow: 0 0 8rpx #FF6B7D;
  vertical-align: 2rpx;
}
@keyframes liveDot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%      { opacity: 0.4; transform: scale(0.85); }
}

/* 聊天滚动区 · 固定高度 + 内滚动 */
.chat-scroll {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 16rpx 12rpx;
  height: 720rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, .04);
}
.chat-empty {
  height: 100%;
  display: flex; align-items: center; justify-content: center;
}

/* 单条 bubble */
.chat-bubble {
  display: flex; align-items: flex-start; gap: 12rpx;
  padding: 10rpx 14rpx;
  margin-bottom: 8rpx;
  animation: bubbleIn .3s ease-out;
}
@keyframes bubbleIn {
  0%   { opacity: 0; transform: translateY(8rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

.chat-bubble.is-mine {
  flex-direction: row-reverse;
}

.chat-bubble-body {
  flex: 1; min-width: 0;
  background: #F4F6F5;
  border-radius: 16rpx;
  padding: 12rpx 16rpx;
  border-left: 4rpx solid transparent;
  max-width: 78%;
}

.chat-bubble.is-mine .chat-bubble-body {
  background: #14B8A6;
  color: #FFFFFF;
  border-left: 0;
  border-right: 4rpx solid rgba(255,255,255,.4);
}

.chat-bubble.is-my-camp .chat-bubble-body {
  background: #ECFDF5;
}

.chat-bubble.is-opponent .chat-bubble-body {
  background: #FFF1F2;
}

.chat-user-name {
  font-size: 22rpx; font-weight: 700; color: #1F2937;
}
.chat-bubble.is-mine .chat-user-name { color: #FFFFFF; }

.chat-text {
  display: block;
  font-size: 26rpx; color: #1F2937;
  line-height: 1.45;
  word-break: break-word;
}
.chat-bubble.is-mine .chat-text { color: #FFFFFF; }

/* Reaction bar */
.chat-reactions {
  display: flex; gap: 10rpx;
  padding: 12rpx 0;
  overflow-x: auto;
}
.reaction-btn {
  flex-shrink: 0;
  width: 76rpx; height: 76rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 36rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.04);
  transition: transform .12s;
}
.reaction-btn:active {
  transform: scale(.88);
  background: #ECFDF5;
}

/* 输入栏 */
.chat-input-row {
  display: flex; gap: 12rpx; align-items: center;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 8rpx 8rpx 8rpx 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, .05);
}
.chat-input {
  flex: 1;
  min-height: 56rpx;
  font-size: 26rpx;
  color: #1F2937;
  background: transparent;
}
.chat-input-locked {
  padding: 14rpx 16rpx;
}
.chat-send-btn {
  flex-shrink: 0;
  min-width: 100rpx;
  height: 56rpx;
  border-radius: 28rpx;
  padding: 0 22rpx;
  background: #E5E7EB;
  color: #9CA3AF;
  font-size: 24rpx;
  font-weight: 700;
  border: 0;
  display: inline-flex; align-items: center; justify-content: center;
}
.chat-send-btn.is-ready {
  background: #14B8A6;
  color: #FFFFFF;
}
.chat-send-btn[disabled] {
  opacity: 1; /* 我们自定 disabled 样式不要默认半透明 */
}
