/* ============================================
   GOAL! 全屏庆祝(F-P0-2)
   触发瞬间:多巴胺爆发 + 球队色脉冲 + confetti 雨
   ============================================ */
.goal-overlay {
  position: fixed; inset: 0;
  z-index: 9999;
  display: flex; align-items: center; justify-content: center;
  background: rgba(0,0,0,.55);
  overflow: hidden;
  animation: fadeIn .25s ease-out;
}
@keyframes fadeIn { from { opacity: 0 } to { opacity: 1 } }

.goal-bg-pulse {
  position: absolute; inset: 0;
  opacity: .85;
  animation: bgPulse 1.2s ease-in-out infinite;
}
@keyframes bgPulse {
  0%, 100% { transform: scale(1); opacity: .8; }
  50% { transform: scale(1.08); opacity: .9; }
}

.confetti {
  position: absolute;
  top: -60rpx;
  border-radius: 4rpx;
  animation: confettiFall linear forwards;
  z-index: 1;
}
@keyframes confettiFall {
  0%   { transform: translateY(0) rotate(0deg);    opacity: 1; }
  60%  { opacity: 1; }
  100% { transform: translateY(140vh) rotate(720deg); opacity: 0; }
}

.goal-content {
  position: relative; z-index: 2;
  text-align: center;
  padding: 60rpx 40rpx;
  max-width: 90vw;
  animation: goalIn .55s cubic-bezier(.22,1.5,.36,1) both;
}
@keyframes goalIn {
  0%   { transform: scale(.4); opacity: 0; }
  60%  { transform: scale(1.12); opacity: 1; }
  100% { transform: scale(1); }
}

.goal-flag-row {
  margin-bottom: 24rpx;
  animation: flagWiggle .8s ease-in-out infinite;
}
@keyframes flagWiggle {
  0%, 100% { transform: rotate(-3deg); }
  50% { transform: rotate(3deg); }
}
.goal-flag-big {
  font-size: 180rpx;
  line-height: 1;
  filter: drop-shadow(0 8rpx 24rpx rgba(0,0,0,.4));
}

.goal-text {
  display: block;
  font-family: 'Bebas Neue', 'Helvetica Neue', sans-serif;
  font-size: 220rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
  line-height: 1;
  text-shadow: 0 6rpx 24rpx rgba(0,0,0,.35);
  margin-bottom: 16rpx;
}
.goal-team {
  display: block;
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  margin-top: 12rpx;
  text-shadow: 0 3rpx 12rpx rgba(0,0,0,.3);
}
.goal-scorer {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 12rpx;
  letter-spacing: 1rpx;
}

.goal-actions {
  display: flex;
  gap: 16rpx;
  justify-content: center;
  margin-top: 48rpx;
}
.goal-actions .btn {
  min-width: 220rpx;
}

/* DEMO 触发按钮(开发期可见 · 生产环境隐藏)*/
.demo-trigger {
  margin-top: 20rpx;
  padding: 14rpx 20rpx;
  background: rgba(20, 184, 166, .08);
  border: 2rpx dashed rgba(20, 184, 166, .4);
  border-radius: 14rpx;
  text-align: center;
}
.demo-trigger-tx {
  font-size: 22rpx; color: #0F766E; font-weight: 600;
  letter-spacing: .5rpx;
}

/* 比赛详情 · 大比分 hero(参考截图 3:Brazil 2 : 4 Italy)*/
.detail-hero {
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
}
.detail-comp {
  font-size: 22rpx; color: #9CA3AF;
  text-transform: uppercase; letter-spacing: 1rpx;
  text-align: center;
  margin-bottom: 20rpx;
}
.hero-vs-row {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 12rpx;
}
.hero-team {
  display: flex; flex-direction: column; align-items: center; gap: 12rpx;
}
.hero-team-name { font-size: 22rpx; color: #6B7280; font-weight: 600; }
.hero-team-code {
  font-size: 30rpx; font-weight: 800; color: #111827; letter-spacing: 1rpx;
}
.hero-vs-meta {
  display: flex; flex-direction: column; align-items: center; gap: 8rpx;
}
.hero-vs-tx {
  font-size: 60rpx; font-weight: 800;
  color: #111827; letter-spacing: 2rpx;
  font-family: 'Helvetica Neue', sans-serif;
}
.hero-countdown {
  font-size: 22rpx; font-weight: 700; color: #14B8A6;
  background: #ECFDF5;
  padding: 6rpx 14rpx; border-radius: 12rpx;
  font-family: ui-monospace, Menlo, monospace;
}
.hero-kickoff {
  font-size: 20rpx; color: #9CA3AF;
}
.hero-venue {
  margin-top: 20rpx;
  font-size: 22rpx; color: #9CA3AF;
  text-align: center;
}

/* ===== Pick row ===== */
.pick-row {
  display: flex; flex-direction: row; gap: 14rpx;
}
.pick {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 26rpx 14rpx;
  display: flex; flex-direction: column; align-items: center; gap: 10rpx;
  border: 4rpx solid transparent;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.03);
  transition: all .15s;
}
.pick.selected {
  border-color: #14B8A6;
  background: #F0FDFA;
  box-shadow: 0 6rpx 20rpx rgba(20, 184, 166, .15);
}
.pick-team {
  font-size: 26rpx; font-weight: 700; color: #1F2937;
  margin-top: 4rpx;
}
.pick.selected .pick-team { color: #0F766E; }
.pick-pct { font-size: 20rpx; color: #9CA3AF; }

.confirm-banner {
  background: #14B8A6;
  color: #fff;
  display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
  padding: 18rpx 26rpx;
  margin-top: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(20, 184, 166, .25);
}
.confirm-banner .tx-teal { color: #fff; }

/* ===== KOL row ===== */
.kol-row {
  display: flex; align-items: center; gap: 16rpx;
  padding: 18rpx 22rpx;
}
.kol-pick-pill {
  background: #ECFDF5;
  padding: 12rpx 20rpx;
  border-radius: 26rpx;
}

/* ===== Discussions ===== */
.discuss-row {
  display: flex; gap: 14rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 14rpx;
}
.discuss-text {
  font-size: 26rpx; color: #1F2937; line-height: 1.5;
}
.empty-discuss {
  background: #ECFDF5;
  border-radius: 20rpx;
  padding: 28rpx;
  display: flex; flex-direction: column; align-items: center;
  text-align: center;
}
