/* ============================================
   KOL 详情页 · 球队色 hero + 真实跳转外链 + 公开发文卡
   ============================================ */

/* === Hero === */
.kd-hero {
  position: relative;
  margin: -24rpx -28rpx 28rpx;
  padding: 40rpx 32rpx 36rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, .15);
}
.kd-hero-stripe {
  position: absolute; inset: 0;
  pointer-events: none;
  background:
    radial-gradient(circle, rgba(255,255,255,.22) 2rpx, transparent 3rpx) 0 0 / 18rpx 18rpx,
    linear-gradient(118deg, transparent 0%, transparent 38%, rgba(255,255,255,.12) 38%, rgba(255,255,255,.12) 46%, transparent 46%);
}
.kd-hero::after {
  content: '⚽';
  position: absolute;
  right: -40rpx; bottom: -50rpx;
  font-size: 280rpx;
  line-height: 1;
  opacity: .12;
  transform: rotate(-18deg);
  pointer-events: none;
  filter: grayscale(.5);
}
.kd-hero-content {
  position: relative; z-index: 1;
  display: flex; flex-direction: column; align-items: center;
  gap: 8rpx;
}

.kd-avatar-frame {
  position: relative;
  margin-bottom: 12rpx;
}
.kd-avatar {
  width: 160rpx; height: 160rpx;
  border-radius: 50%;
  background: rgba(255,255,255,.22);
  border: 4rpx solid rgba(255,255,255,.5);
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 96rpx;
  line-height: 1;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,.2);
}
.kd-tier-badge {
  position: absolute; top: -8rpx; right: -8rpx;
  background: linear-gradient(135deg, #FFD54A, #F0AB22);
  color: #1A1A0A;
  font-family: 'Bebas Neue', sans-serif;
  font-size: 26rpx; font-weight: 900;
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  display: inline-flex; align-items: center; justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,.2);
}

.kd-name {
  font-family: 'Helvetica Neue', sans-serif;
  font-size: 44rpx; font-weight: 900;
  letter-spacing: -.5rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,.18);
}
.kd-real-name {
  font-size: 22rpx; font-weight: 500;
  letter-spacing: .5rpx;
}
.kd-handle {
  font-family: 'JetBrains Mono', ui-monospace, Menlo, monospace;
  font-size: 26rpx; font-weight: 700;
  opacity: .85;
  margin-top: 6rpx;
}

.kd-meta-row {
  display: flex; gap: 10rpx;
  margin-top: 16rpx;
}
.kd-meta-pill {
  height: 40rpx; padding: 0 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx; font-weight: 600;
  display: inline-flex; align-items: center;
}
.kd-bio {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.45;
  text-align: center;
  max-width: 540rpx;
}

/* === Stats 一行 === */
.kd-stats {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 28rpx;
  display: flex; align-items: center; justify-content: space-between;
  box-shadow: 0 2rpx 12rpx rgba(15,23,42,.04);
}
.kd-stat {
  flex: 1;
  display: flex; flex-direction: column; align-items: center; gap: 4rpx;
}
.kd-stat-val {
  font-family: 'Helvetica Neue', sans-serif;
  font-size: 34rpx; font-weight: 800;
  color: #14B8A6;
  letter-spacing: -.5rpx;
}
.kd-stat-lbl {
  font-size: 18rpx; color: #9CA3AF;
  text-transform: uppercase; letter-spacing: .5rpx;
}
.kd-stat-divider {
  width: 2rpx; height: 36rpx;
  background: #E5E7EB;
}

.kd-actions {
  margin-bottom: 12rpx;
}

/* === External link rows · 真实跳转 === */
.kd-link-row {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 24rpx;
}
.kd-link-icon {
  width: 64rpx; height: 64rpx;
  border-radius: 16rpx;
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 30rpx; color: #FFFFFF;
  font-weight: 700;
  flex-shrink: 0;
}
.kd-link-icon.twitter   { background: #000000; }
.kd-link-icon.youtube   { background: #FF0000; }
.kd-link-icon.instagram { background: linear-gradient(45deg, #FFD600, #FF7A00, #FF1493, #C13584); }
.kd-link-icon.kick      { background: #53FC18; color: #000000; }
.kd-link-icon.tiktok    { background: #000000; }
.kd-link-icon.website   { background: #14B8A6; }
.kd-link-platform {
  font-size: 26rpx; font-weight: 700; color: #1F2937;
}
.kd-link-url {
  font-size: 22rpx; color: #6B7280;
  font-family: 'JetBrains Mono', ui-monospace, Menlo, monospace;
}
.kd-link-arrow {
  font-size: 36rpx; color: #9CA3AF; font-weight: 300;
}

/* === Quote cards · 公开发文(fair use) === */
.kd-empty {
  padding: 40rpx;
  text-align: center;
}
.kd-quote {
  padding: 24rpx 26rpx 18rpx;
  position: relative;
  background: linear-gradient(180deg, #FFFFFF 0%, #FAFAFC 100%);
}
.kd-quote-mark {
  position: absolute;
  top: -8rpx; left: 18rpx;
  font-family: 'Helvetica Neue', sans-serif;
  font-size: 120rpx; font-weight: 900;
  color: #14B8A6;
  opacity: .18;
  line-height: 1;
}
.kd-quote-text {
  display: block;
  font-size: 28rpx;
  color: #1F2937;
  line-height: 1.5;
  font-style: italic;
  margin-bottom: 16rpx;
  position: relative; z-index: 1;
}
.kd-quote-foot {
  display: flex; justify-content: space-between; align-items: center;
  padding-top: 12rpx;
  border-top: 2rpx solid #F4F6F5;
  margin-bottom: 12rpx;
}
.kd-quote-source {
  font-size: 20rpx; color: #6B7280; font-weight: 600;
}
.kd-quote-time {
  font-size: 20rpx; color: #9CA3AF;
  font-family: 'JetBrains Mono', ui-monospace, Menlo, monospace;
}
.kd-quote-cta {
  text-align: right;
  font-size: 22rpx;
}

/* === Recent picks === */
.kd-pick-row {
  padding: 20rpx 24rpx;
}

/* === Outreach status(dev)=== */
.kd-outreach {
  margin: 24rpx 0 0;
  padding: 14rpx 16rpx;
  background: rgba(255, 213, 74, .08);
  border: 2rpx dashed rgba(255, 213, 74, .35);
  border-radius: 12rpx;
  display: flex; flex-direction: column; gap: 4rpx;
}
