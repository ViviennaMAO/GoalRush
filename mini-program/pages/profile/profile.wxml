<view class="page">

  <!-- ===== 球迷身份卡 ===== -->
  <view class="card card-deep me-hero">
    <view class="row row-gap-md" style="align-items: center;">
      <view class="avatar avatar-xl avatar-ring" style="background: rgba(255,255,255,.25);">
        <text>{{myTeamFlag || '⚽'}}</text>
      </view>
      <view class="col" style="flex: 1; gap: 6rpx;">
        <text class="me-name">{{wallet ? wallet.nickname : '游客'}}</text>
        <text class="me-handle">{{wallet ? walletShort : '未连接钱包'}}</text>
        <view class="row row-gap-sm" style="margin-top: 8rpx;">
          <text class="pill" style="background: rgba(255,255,255,.2); color: #fff;">{{title.emoji}} {{title.name}}</text>
          <text class="pill" style="background: rgba(255,255,255,.2); color: #fff;">Lv.{{fanLevel}}</text>
        </view>
      </view>
    </view>

    <view class="me-stats">
      <view class="me-stat">
        <text class="me-stat-val">{{predCount}}</text>
        <text class="me-stat-lbl">已预测</text>
      </view>
      <view class="me-stat">
        <text class="me-stat-val">{{hitCount}}</text>
        <text class="me-stat-lbl">命中</text>
      </view>
      <view class="me-stat">
        <text class="me-stat-val">{{eds}}</text>
        <text class="me-stat-lbl">EDS</text>
      </view>
      <view class="me-stat">
        <text class="me-stat-val">{{(follows || []).length}}</text>
        <text class="me-stat-lbl">关注</text>
      </view>
    </view>
  </view>

  <!-- ===== Luffa wallet 入口 ===== -->
  <view wx:if="{{!wallet}}" class="card" style="background: linear-gradient(135deg, #F0EDFF, #FFFFFF);">
    <view class="col" style="gap: 12rpx; padding: 8rpx 0;">
      <text class="tx-h3">连接 Luffa 钱包 · 真领 EDS</text>
      <text class="tx-body">未连接时,你的预测仅本地保存。连接后,EDS 真金直接到 Luffa 钱包。</text>
      <button class="btn btn-primary" style="margin-top: 12rpx;" bindtap="onConnect">连接 Luffa 钱包</button>
    </view>
  </view>

  <view wx:else class="card">
    <view class="row-between">
      <view class="col" style="gap: 6rpx;">
        <text class="tx-small">Luffa 钱包地址</text>
        <text class="tx-mono">{{walletShort}}</text>
      </view>
      <view class="col" style="align-items: flex-end; gap: 6rpx;">
        <text class="tx-small">EDS 余额</text>
        <text class="tx-h3 tx-purple">{{eds}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 我的预测 ===== -->
  <view class="section">
    <view class="section-head">
      <view>
        <text class="section-title">我的预测</text>
        <view class="section-sub">{{predCount}} 场 · {{pendingCount}} 待结算</view>
      </view>
    </view>

    <view wx:if="{{!myPreds.length}}" class="card" style="text-align: center; color: #9CA3AF; padding: 48rpx;">
      还没押 · <text class="tx-purple" bindtap="goMatches">去看比赛 →</text>
    </view>

    <view wx:for="{{myPreds}}" wx:key="id" class="card pred-row" bindtap="goMatch" data-id="{{item.id}}">
      <view class="row row-gap-sm" style="flex: 1;">
        <view class="avatar avatar-sm"><text>{{item.homeTeam.flag}}</text></view>
        <text class="tx-bold">{{item.homeTeam.code}}</text>
        <text class="tx-muted">vs</text>
        <text class="tx-bold">{{item.awayTeam.code}}</text>
        <view class="avatar avatar-sm"><text>{{item.awayTeam.flag}}</text></view>
      </view>
      <view class="col" style="align-items: flex-end; gap: 4rpx;">
        <text class="pill pill-purple">押 {{item.pickLabel}}</text>
        <text class="tx-small">{{item.countdown}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 关注的 KOL ===== -->
  <view class="section" wx:if="{{followedKols.length}}">
    <view class="section-head">
      <view>
        <text class="section-title">关注的 KOL</text>
      </view>
    </view>
    <view wx:for="{{followedKols}}" wx:key="id" class="card kol-row">
      <view class="avatar"><text>{{item.flag}}</text></view>
      <view class="col" style="flex: 1; gap: 4rpx;">
        <text class="tx-bold">{{item.name}}</text>
        <text class="tx-small">命中率 {{item.hit_rate}}% · 当前排 #{{item.current_rank}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 设置 ===== -->
  <view class="section">
    <view class="card menu-row" bindtap="clearLocal">
      <text>🧹 清空本地数据</text>
      <text class="tx-muted">›</text>
    </view>
  </view>

  <view class="legal">
    <text>GoalRush · Powered by Luffa · Play-money + utility token reward</text>
    <text>Operated within a group holding HK SFC licenses</text>
  </view>

</view>
