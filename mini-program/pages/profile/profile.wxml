<view class="page">

  <!-- ===== 球迷身份卡 ===== -->
  <view class="card me-hero">
    <view class="row row-gap-md" style="align-items: center;">
      <view class="avatar avatar-xl avatar-ring">
        <text>{{myTeamFlag || '⚽'}}</text>
      </view>
      <view class="col" style="flex: 1; gap: 6rpx;">
        <text class="me-name">{{wallet ? wallet.nickname : i18n.prof_guest}}</text>
        <text class="me-handle">{{wallet ? walletShort : i18n.prof_no_wallet}}</text>
        <view class="row row-gap-sm" style="margin-top: 8rpx;">
          <text class="pill pill-teal">{{titleName}}</text>
          <text class="pill pill-light">Lv.{{fanLevel}}</text>
        </view>
      </view>
    </view>

    <view class="me-stats">
      <view class="me-stat">
        <text class="me-stat-val">{{predCount}}</text>
        <text class="me-stat-lbl">{{i18n.prof_stat_picks}}</text>
      </view>
      <view class="me-stat">
        <text class="me-stat-val">{{hitCount}}</text>
        <text class="me-stat-lbl">{{i18n.prof_stat_hits}}</text>
      </view>
      <view class="me-stat">
        <text class="me-stat-val">{{eds}}</text>
        <text class="me-stat-lbl">{{i18n.prof_stat_eds}}</text>
      </view>
      <view class="me-stat">
        <text class="me-stat-val">{{(follows || []).length}}</text>
        <text class="me-stat-lbl">{{i18n.prof_stat_follows}}</text>
      </view>
    </view>
  </view>

  <!-- ===== Luffa wallet 余额(auto-connect 默认 · 无需按钮)===== -->
  <view class="card">
    <view class="row-between">
      <view class="col" style="gap: 6rpx; min-width: 0;">
        <text class="tx-small">{{i18n.prof_wallet_label}}</text>
        <text class="tx-mono">{{wallet ? walletShort : '— · open in Luffa to sync'}}</text>
      </view>
      <view class="col" style="align-items: flex-end; gap: 6rpx;">
        <text class="tx-small">{{i18n.prof_eds_label}}</text>
        <text class="tx-h3 tx-teal">{{eds}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 我的预测 ===== -->
  <view class="section">
    <view class="section-head">
      <view>
        <text class="section-title">{{i18n.prof_my_picks}}</text>
        <view class="section-sub">{{predCount}} · {{pendingCount}} {{i18n.prof_pending_suffix}}</view>
      </view>
    </view>

    <view wx:if="{{!myPreds.length}}" class="card" style="text-align: center; color: #9CA3AF; padding: 48rpx;">
      {{i18n.prof_no_picks}} <text class="tx-teal" bindtap="goMatches">{{i18n.prof_no_picks_cta}}</text>
    </view>

    <view wx:for="{{myPreds}}" wx:key="id" class="card pred-row" bindtap="goMatch" data-id="{{item.id}}">
      <view class="row row-gap-sm" style="flex: 1;">
        <view class="avatar avatar-sm"><text>{{item.homeTeam.flag}}</text></view>
        <text class="tx-bold">{{item.homeTeam.code}}</text>
        <text class="tx-muted">vs</text>
        <text class="tx-bold">{{item.awayTeam.code}}</text>
        <view class="avatar avatar-sm"><text>{{item.awayTeam.flag}}</text></view>
      </view>
      <view class="col" style="align-items: flex-end; gap: 4rpx;">
        <text class="pill pill-solid">{{item.pickLabel}}</text>
        <text class="tx-small">{{item.countdown}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 关注的 KOL ===== -->
  <view class="section" wx:if="{{followedKols.length}}">
    <view class="section-head">
      <view>
        <text class="section-title">{{i18n.prof_followed_title}}</text>
      </view>
    </view>
    <view wx:for="{{followedKols}}" wx:key="id" class="card kol-row">
      <view class="avatar"><text>{{item.flag}}</text></view>
      <view class="col" style="flex: 1; gap: 4rpx;">
        <text class="tx-bold">{{item.name}}</text>
        <text class="tx-small">{{item.hit_rate}}% · #{{item.current_rank}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 语言切换 ===== -->
  <view class="section">
    <view class="section-head">
      <view>
        <text class="section-title">{{i18n.prof_lang}}</text>
      </view>
    </view>
    <view class="card" style="padding: 0;">
      <view wx:for="{{langs}}" wx:key="key" class="lang-row {{item.key === currentLang ? 'active' : ''}}"
        bindtap="onPickLang" data-key="{{item.key}}">
        <text class="lang-row-label">{{item.label}}</text>
        <text wx:if="{{item.key === currentLang}}" class="tx-teal">✓</text>
      </view>
    </view>
  </view>

  <!-- ===== 设置 ===== -->
  <view class="section">
    <view class="card menu-row" bindtap="clearLocal">
      <text>{{i18n.prof_clear_local}}</text>
      <text class="tx-muted">›</text>
    </view>
  </view>

  <view class="legal">
    <text>{{i18n.prof_legal_1}}</text>
    <text>{{i18n.prof_legal_2}}</text>
  </view>

</view>
