.me-hero {
  padding: 36rpx 28rpx 28rpx;
  margin-bottom: 24rpx;
}
.me-name { font-size: 38rpx; font-weight: 800; color: #111827; letter-spacing: -.5rpx; }
.me-handle {
  font-size: 22rpx; color: #9CA3AF;
  font-family: ui-monospace, Menlo, monospace;
}
.me-stats {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-top: 28rpx; padding-top: 24rpx;
  border-top: 2rpx solid #F4F6F5;
}
.me-stat { display: flex; flex-direction: column; gap: 4rpx; align-items: center; }
.me-stat-val {
  font-size: 36rpx; font-weight: 800; color: #14B8A6;
  font-family: 'Helvetica Neue', sans-serif; letter-spacing: -.5rpx;
}
.me-stat-lbl { font-size: 18rpx; color: #9CA3AF; }

.pred-row {
  display: flex; align-items: center; gap: 16rpx;
  padding: 22rpx 26rpx;
}
.kol-row {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 26rpx;
}
.menu-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 22rpx 26rpx;
  font-size: 28rpx;
}

.lang-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 22rpx 26rpx;
  font-size: 28rpx;
  border-bottom: 2rpx solid #F4F6F5;
}
.lang-row:last-child { border-bottom: 0; }
.lang-row.active { background: #F0FDFA; }
.lang-row-label { font-weight: 600; color: #1F2937; }
