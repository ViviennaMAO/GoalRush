.me-hero {
  padding: 40rpx 32rpx 32rpx;
  margin-bottom: 24rpx;
}
.me-name { font-size: 40rpx; font-weight: 800; color: #fff; letter-spacing: -.5rpx; }
.me-handle {
  font-size: 22rpx; color: rgba(255,255,255,.7);
  font-family: ui-monospace, Menlo, monospace;
}
.me-stats {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-top: 28rpx; padding-top: 24rpx;
  border-top: 2rpx solid rgba(255,255,255,.15);
}
.me-stat { display: flex; flex-direction: column; gap: 4rpx; align-items: center; }
.me-stat-val { font-size: 36rpx; font-weight: 800; color: #fff; }
.me-stat-lbl { font-size: 18rpx; color: rgba(255,255,255,.7); }

.pred-row {
  display: flex; align-items: center; gap: 16rpx;
  padding: 24rpx 28rpx;
}
.kol-row {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 28rpx;
}
.menu-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
}

.lang-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  border-bottom: 2rpx solid #F4F5F7;
}
.lang-row:last-child { border-bottom: 0; }
.lang-row.active { background: #F5F2FF; }
.lang-row-label { font-weight: 600; color: #1A1A2E; }
